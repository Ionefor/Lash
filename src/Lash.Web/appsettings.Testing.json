{
  "ConnectionStrings": {
    "UsersDatabase": "Host=localhost;Database=lash_test;Username=lash;Password=lash"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "lash-tests",
    "Audience": "lash-tests-client",
    "Key": "a-secure-signing-key-with-at-least-32-characters",
    "ExpiredMinutesTime": 15,
    "RefreshTokenLifetimeDays": 30,
    "RefreshTokenAbsoluteLifetimeDays": 90
  },
  "Email": {
    "Host": "localhost",
    "Port": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@example.com",
    "UseSsl": true
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false,
    "ApplySeedOnStartup": false
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "RolePermissions": {
    "Permissions": {},
    "Roles": {}
  },
  "AllowedHosts": "*"
}
